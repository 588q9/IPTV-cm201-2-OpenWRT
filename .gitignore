# 采用白名单：本机历史资料保留，只有明确整理过的文件进入公开仓库。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSES/
/LICENSES/*
!/LICENSES/LGPL-2.1-only.txt
!/LICENSES/GPL-2.0-only.txt
!/THIRD_PARTY.md
!/resources.lock.json
!/requirements.lock
!/tools/
/tools/*
!/tools/project.py
!/tools/cm2012/
!/tools/network-assessment/
/tools/network-assessment/*
!/tools/network-assessment/README.md
!/tools/network-assessment/inspect_archives.py
!/tools/network-assessment/probe.py
!/tools/network-assessment/run_probe.py
!/tools/network-assessment/cleanup.py
!/tools/network-assessment/final_check.py
!/tools/network-assessment/sft_final_check.py
!/tools/network-assessment/cm-inside.sh
!/tools/network-assessment/netns_exec.c
!/tools/network-assessment/tun_probe.c
!/tools/network-assessment/disabled.json
!/tools/network-assessment/archives.json
!/tools/internal_switch_root.c
!/tools/ubusd_compat_start.c
!/tools/restore_elf_link_sections.py
!/tools/internal-root-init
!/tests/
/tests/*
!/tests/test_public_*.py
!/tests/integration/
/tests/integration/*
!/tests/integration/test_compiler.py
!/tests/integration/test_proxy_fetch_ssh.py
!/tests/integration/test_proxy_fetch_github_ssh.py
!/tests/fixtures/
!/tests/device/
/tests/device/*
!/tests/device/cm2012-rpc.uc
!/tests/device/cm2012-wireless.uc
!/tests/device/cm2012-network.uc
!/tests/device/cm2012-rollback.uc
!/tests/device/cm2012-netlink.c
!/configs/
/configs/*
!/configs/templates/
!/configs/remote-proxy/
!/configs/resource-snapshots/
/configs/resource-snapshots/*
!/configs/resource-snapshots/README.md
!/configs/resource-snapshots/provenance.json
!/configs/resource-snapshots/base-20261011/
!/configs/resource-snapshots/base/
!/configs/resource-snapshots/packages/
!/configs/resource-snapshots/luci/
!/configs/resource-snapshots/target/
/configs/resource-snapshots/*/*
!/configs/resource-snapshots/base-20261011/packages.adb
!/configs/resource-snapshots/base/packages.adb
!/configs/resource-snapshots/packages/packages.adb
!/configs/resource-snapshots/luci/packages.adb
!/configs/resource-snapshots/target/packages.adb
!/docs/
/docs/*
!/docs/公开文档/
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-10-07-public-build-design.md
!/docs/superpowers/specs/2026-11-01-release-readiness-design.md
!/docs/superpowers/plans/
/docs/superpowers/plans/*
!/docs/superpowers/plans/2026-10-07-public-build-plan.md
!/docs/superpowers/plans/2026-10-18-cm2012-remote-networking.md
!/docs/superpowers/plans/2026-10-24-cm2012-tls-entropy-fix.md
!/docs/superpowers/plans/2026-10-25-cm2012-provider-preparation.md
!/docs/superpowers/plans/2026-11-01-release-readiness.md
!/tests/device/cm2012-tailscale.uc
!/tests/device/cm2012-proxy.uc
!/.github/
**/__pycache__/
*.pyc
*.pyo

# 白名单目录内也可能生成测试、检查器及编译缓存。
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.zig-cache/
**/zig-cache/
**/zig-local-cache/
**/zig-out/

# 本地调试日志不进入版本控制。
/log/
*.log
