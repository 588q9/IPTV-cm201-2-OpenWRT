# 采用白名单：本机历史资料保留，只有明确整理过的文件进入公开仓库。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSES/
/LICENSES/*
!/LICENSES/LGPL-2.1-only.txt
!/THIRD_PARTY.md
!/resources.lock.json
!/requirements.lock
!/tools/
/tools/*
!/tools/project.py
!/tools/cm2012/
!/tools/internal_switch_root.c
!/tools/ubusd_compat_start.c
!/tools/restore_elf_link_sections.py
!/tools/internal-root-init
!/tests/
/tests/*
!/tests/test_public_*.py
!/tests/fixtures/
!/configs/
/configs/*
!/configs/templates/
!/docs/
/docs/*
!/docs/公开文档/
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-10-07-public-build-design.md
!/docs/superpowers/plans/
/docs/superpowers/plans/*
!/docs/superpowers/plans/2026-10-07-public-build-plan.md
!/.github/
**/__pycache__/
*.pyc
