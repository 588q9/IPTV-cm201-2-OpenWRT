#!/bin/sh /etc/rc.common
START=94
STOP=10
USE_PROCD=1
start_service() {
 [ "$(uci -q get cm2012_proxy.settings.enabled || echo 0)" = 1 ] || return 0
 [ -s /etc/cm2012-proxy/active.json ] || return 0
 procd_open_instance
 procd_set_param command /usr/bin/mihomo -d /etc/cm2012-proxy -f /etc/cm2012-proxy/active.json
 procd_set_param env SAFE_PATHS=/www/metacubexd:/usr/share/cm2012/geodata
 procd_set_param respawn 3600 5 3
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
stop_service() { /usr/libexec/cm2012-proxy suspend || true; }
