#!/bin/sh /etc/rc.common
START=96
STOP=15
USE_PROCD=1
start_service() {
 local module attempt=0
 for module in cfg80211 hi_sdio_detect wlan_mt7668_sdio; do
  [ -d "/sys/module/$module" ] || insmod "/lib/modules/3.18.24_hi3798mv2x/$module.ko" || return 1
 done
 while [ ! -d /sys/class/net/ap0 ]; do
  attempt=$((attempt+1)); [ "$attempt" -le 60 ] || return 1
  sleep 1
 done
 procd_open_instance wifi
 procd_set_param command /usr/libexec/cm2012-wifi run
 procd_set_param file /etc/config/cm2012
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
reload_service() { stop; start; }
service_triggers() { procd_add_reload_trigger cm2012; }
