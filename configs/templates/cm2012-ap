#!/bin/sh /etc/rc.common

START=96
STOP=15
USE_PROCD=1

start_service() {
	local module attempt
	[ -r /etc/cm2012/hostapd.conf ] && [ -r /etc/cm2012/dnsmasq-ap.conf ] || {
		logger -t cm2012-ap '缺少热点配置，停止启动'
		return 1
	}
	for module in cfg80211 hi_sdio_detect wlan_mt7668_sdio; do
		[ -d "/sys/module/$module" ] ||
			insmod "/lib/modules/3.18.24_hi3798mv2x/$module.ko" || return 1
	done
	attempt=0
	while [ ! -d /sys/class/net/ap0 ]; do
		attempt=$((attempt + 1))
		[ "$attempt" -le 60 ] || {
			logger -t cm2012-ap '等待 ap0 接口超时'
			return 1
		}
		sleep 1
	done
	procd_open_instance hostapd
	procd_set_param command /usr/sbin/hostapd /etc/cm2012/hostapd.conf
	procd_set_param file /etc/cm2012/hostapd.conf
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance dhcp
	procd_set_param command /usr/libexec/cm2012-ap-dhcp
	procd_set_param file /etc/cm2012/dnsmasq-ap.conf
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
