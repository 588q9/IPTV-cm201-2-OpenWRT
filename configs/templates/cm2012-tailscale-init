#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
 /usr/libexec/cm2012-tailscale prepare || return 1
 [ -f /var/run/cm2012-tailscale/ready ] || return 0
 umask 077
 mkdir -p /etc/tailscale /var/run/tailscale /var/run/cm2012-tailscale/logs || return 1
 chmod 700 /etc/tailscale /var/run/tailscale /var/run/cm2012-tailscale /var/run/cm2012-tailscale/logs || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/tailscaled --config=/var/run/cm2012-tailscale/daemon.json --state=/etc/tailscale/tailscaled.state --statedir=/etc/tailscale --socket=/var/run/tailscale/tailscaled.sock --tun=tailscale0 --port=41641 --no-logs-no-support
 procd_set_param env TS_TUN_DISABLE_UDP_GRO=true TS_TUN_DISABLE_TCP_GRO=true TS_LOGS_DIR=/var/run/cm2012-tailscale/logs
 # Bounded restarts; persistent failure remains visible for local repair.
 procd_set_param respawn 3600 5 3
 procd_set_param file /etc/config/cm2012_tailscale /var/run/cm2012-tailscale/daemon.json
 procd_close_instance
 rm -f /var/run/cm2012-tailscale/restart-required
}
stop_service() { /usr/libexec/cm2012-tailscale clear; }
reload_service() { /usr/libexec/cm2012-tailscale reconcile; }
