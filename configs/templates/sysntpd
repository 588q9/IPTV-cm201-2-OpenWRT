#!/bin/sh /etc/rc.common
START=98
USE_PROCD=1
start_service() {
 local enabled server
 config_load system
 config_get enabled ntp enabled 1
 [ "$enabled" = 1 ] || return 0
 procd_open_instance ntp
 procd_set_param command /usr/sbin/ntpd -n -N
 append_server() { procd_append_param command -p "$1"; }
 config_list_foreach ntp server append_server
 procd_set_param respawn 3600 10 5
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger system; }
